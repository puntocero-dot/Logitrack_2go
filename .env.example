# Configuración de Base de Datos
DB_USER=user
DB_PASSWORD=password
DB_NAME=logitrack
# sslmode=disable solo en desarrollo local; en producción se fuerza a sslmode=require automáticamente
DATABASE_URL=postgres://user:password@postgres:5432/logitrack?sslmode=disable

# Configuración de Redis
REDIS_PASSWORD=logitrack_redis_password
REDIS_URL=redis://:logitrack_redis_password@redis:6379/0

# Seguridad
# JWT_SECRET: mínimo 32 caracteres (256 bits). Generar con: openssl rand -hex 32
# El servicio falla al arrancar si está vacío o tiene menos de 32 chars.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# SEED_SUPERADMIN_PASSWORD: password del superadmin inicial. Mínimo 12 chars.
# Requerido en producción (ENV=production); en dev se genera uno aleatorio si está vacío.
# Recomendado: mayúsculas + minúsculas + números + símbolos, mínimo 16 chars.
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN12CHARS

# SEED_USER_PASSWORD: password para usuarios de prueba (solo desarrollo)
SEED_USER_PASSWORD=CHANGE_ME_DEV_ONLY

# ENV: entorno de ejecución. Valores: development | production
# En production: JWT_SECRET obligatorio, sslmode forzado a require, HSTS activado
ENV=development

# ALLOWED_ORIGINS: lista de orígenes CORS permitidos, separados por coma.
# Si está vacío, usa defaults: localhost:3001, localhost:3002, 10.23.150.40:3001/3002 + Railway.
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://10.23.150.40:3001,http://10.23.150.40:3002

# Puertos
PORT_GATEWAY=8085
PORT_USER=8086
PORT_ORDER=8087
PORT_GEO=8088
PORT_AI=5001
PORT_WEB=3001
PORT_CLIENT=3002
